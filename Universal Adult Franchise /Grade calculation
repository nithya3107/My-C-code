#include<stdio.h>
int main()
{
    int mark;
    printf("Enter your mark of the subject:");
    scanf("%d",&mark);
    if(mark>=90 && mark<=100)
    {
        printf("Your grade:A");
    }
    else
    if(mark>=80 && mark<=90)
    {
        printf("Your grade:B");
    }
    else
    if(mark>=70 && mark<=80)
    {
        printf("Your grade:C");
    }
    else 
    if(mark>=60 && mark<=70)
    {
        printf("Your grade:D");
    }
    else
    if(mark>=50 && mark<=60)
    {
        printf("Your grade:E");
    }
    else
    if(mark>=0 && mark<=50)
    {
        printf("Your grade:F");
    }
    return 0;
}